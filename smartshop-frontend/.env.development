# Vite only exposes env vars prefixed with VITE_ to client-side code (import.meta.env).
# Never put secret API keys here — anything in this file is bundled into the browser bundle!
#
# In development we use /api so requests hit Vite's proxy (see vite.config.ts) → gateway :8080.
VITE_API_BASE_URL=/api
VITE_APP_NAME=SmartShop Dev
VITE_ENABLE_DEVTOOLS=true
